{
  "title": "Live2Shop Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "type": "stat",
      "title": "Gateway requests",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{service=\"event-gateway\"}[1m]))"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Recommendation P95",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"recommendation-api\"}[5m])) by (le))"
        }
      ],
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Content AI latency P95",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(content_ai_segment_seconds_bucket[5m])) by (le))"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "RecModel event lag",
      "targets": [
        {
          "expr": "recmodel_event_lag_seconds"
        }
      ],
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      }
    }
  ]
}