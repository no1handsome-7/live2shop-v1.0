SCREEN_WIDTH=1280
SCREEN_HEIGHT=720
SCREEN_DEPTH=24
VNC_HOST_PORT=5901
TZ=Asia/Shanghai
LIVE2SHOP_DISABLE_BROWSER_SANDBOX=1

# Optional outbound proxy.
# A host-only proxy at 127.0.0.1 is not reachable from a bridged container as 127.0.0.1.
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1,::1
