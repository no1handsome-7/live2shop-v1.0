POSTGRES_DB=live2shop
POSTGRES_USER=live2shop
POSTGRES_PASSWORD=live2shop
POSTGRES_DSN=postgresql://live2shop:live2shop@postgres:5432/live2shop

REDIS_URL=redis://redis:6379/0
KAFKA_BROKERS=kafka:9092

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=live2shop
MINIO_SECRET_KEY=live2shop-secret
MINIO_SECURE=false
MEDIA_BUCKET=live2shop-media
LAKE_BUCKET=live2shop-lake

MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_S3_ENDPOINT_URL=http://minio:9000

MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION=live2shop_items

SRS_HTTP_URL=http://srs:8080
SRS_RTMP_URL=rtmp://srs:1935/live

CONTENT_AI_MODEL_DIR=/models/commerce-vlm/champion
CONTENT_AI_GPU=0
CONTENT_AI_BACKEND=trained
CONTENT_AI_MODEL_VERSION=commerce-vlm-v1
WHISPER_MODEL=small
OCR_BACKEND=rapidocr

REC_MODEL_DIR=/models/rec-model/champion
REC_MODEL_GPU=1
REC_MODEL_BACKEND=trained
REC_MODEL_VERSION=rec-model-v1

WEB_PUBLIC_GATEWAY=http://localhost:8088
WEB_PUBLIC_RECOMMENDATION=http://localhost:8090
WEB_PUBLIC_HLS=http://localhost:8080
